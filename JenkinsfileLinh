pipeline{
    agent any
    stages{
        stage('Build'){
            agent{
                docker{
                    image 'node:22-alpine'
                    reuseNode true
                }
            }
            steps{
                sh '''
                    npm ci
                    npm run build
                    if test -d "duong/dan/thu/muc"; then
                        echo "Yes"
                    fi
                '''
            }
        }
        stage('parallel stages'){
            parallel{
                stage('Unit Test'){
                    agent{
                        docker{
                            image 'node:22-alpine'
                            reuseNode true
                        }
                    }
                    steps{
                        sh '''
                            npm run test:unit
                        '''
                    }
                }
                stage('Integration Test'){
                    agent{
                        docker{
                            image 'mcr.microsoft.com/playwright:v1.54.2-noble'
                            reuseNode true
                        }
                    }
                    steps{
                        sh '''
                            npx playwright test
                        '''
                    }
                    post{
                        always{
                            publishHTML(target:[
                                reportName: 'Report - Integration Test',
                                reportDir: 'reports-e2e/html',
                                reportFiles: 'index.html'
                            ])
                            junit 'reports-e2e/junit.xml'
                        }
                    }
                }
            }
        }
        stage('Mock Deployment'){
            steps{
                sh '''
                    echo "This is mock deployment"
                '''
            }
        }
        stage('E2E Test'){
            steps{
                sh '''
                    echo "This is E2E Test"
                '''
            }
        }
    }
}